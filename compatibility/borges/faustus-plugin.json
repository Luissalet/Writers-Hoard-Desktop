{
  "schema": 1,
  "id": "borges",
  "name": "Borges's Hoard \u00b7 Writer's Hoard",
  "purpose": "Personal library, saved articles and paperwork: cited document search, read-later, media, original files, OCR, PDF workshop, deadlines and reminders. Independent native modules and automation switches, all OFF initially; explicit launch only.",
  "capabilities": [
    "library",
    "documents",
    "hybrid-search",
    "citations",
    "passages",
    "pdf",
    "docx",
    "markdown",
    "epub",
    "html",
    "collections",
    "folder-watch",
    "reindex",
    "similar-passages",
    "local-embeddings",
    "faustus-conversations",
    "saved-links",
    "sources",
    "date-range-search",
    "pptx",
    "slide-citations",
    "paperwork",
    "document-text-comparison",
    "deadlines",
    "invoices",
    "contracts",
    "insurance",
    "warranties",
    "fines",
    "renewals",
    "working-days",
    "ocr",
    "pdf-tools",
    "owned-pdf-engine",
    "pdf-paragraph-editing",
    "pdf-artifact-revisions",
    "pdf-merge",
    "pdf-compress",
    "image-compress",
    "mail-import",
    "reminders",
    "notifications",
    "windows-toast",
    "ntfy",
    "telegram",
    "email",
    "price-changes",
    "search",
    "dashboard",
    "family-agenda",
    "hub-notifications",
    "hub-mail",
    "tax-pack",
    "ledger-link",
    "minutes-deadlines",
    "bookmarks",
    "read-later",
    "extraction",
    "tags",
    "highlights",
    "digest",
    "import",
    "watches",
    "feeds",
    "github-releases",
    "page-changes",
    "event-bus",
    "media-download",
    "video-download",
    "audio-download",
    "highlights-to-flashcards",
    "resurface",
    "time-budgeted-reading-plan",
    "daily-digest",
    "job-events",
    "independent-module-switches",
    "default-off",
    "shared-native-search"
  ],
  "placeholders": [
    "COMPAT_DIR",
    "WRITER_DIR",
    "OWNER_URL",
    "APP_URL",
    "TOKEN_FILE",
    "DATA_DIR",
    "WRITER_EXE",
    "WRITER_ADAPTER"
  ],
  "defaults": {
    "WRITER_DIR": "{COMPAT_DIR}/../..",
    "OWNER_URL": "http://127.0.0.1:8766",
    "APP_URL": "{OWNER_URL}/compat/borges",
    "TOKEN_FILE": "%APPDATA%/writers-hoard/aibridge/token",
    "DATA_DIR": "%APPDATA%/writers-hoard/publishing/data/library",
    "WRITER_EXE": "%LOCALAPPDATA%/Programs/Writers Hoard/Writers Hoard.exe",
    "WRITER_ADAPTER": "%LOCALAPPDATA%/Programs/Writers Hoard/resources/app.asar.unpacked/dist-electron/aibridge/mcpStdio.cjs"
  },
  "app": {
    "url_default": "{APP_URL}",
    "ui_url": null,
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "writers-hoard-ai-bridge"
      }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{WRITER_EXE}",
    "args": [
      "{WRITER_ADAPTER}",
      "--publishing-module",
      "borges"
    ],
    "env": {
      "ELECTRON_RUN_AS_NODE": "1",
      "WH_BRIDGE_URL": "{OWNER_URL}",
      "WH_BRIDGE_TOKEN_FILE": "{TOKEN_FILE}"
    }
  },
  "x-family": {
    "standalone": false,
    "agent_contract": true,
    "absorbed_by": {
      "id": "writer",
      "module": "borges",
      "standalone": false,
      "repository": "https://github.com/Luissalet/Writers-Hoard-Desktop"
    }
  },
  "notes": "Capabilities and native data belong to Writer's Hoard. Modules are enabled explicitly in the owner."
}
