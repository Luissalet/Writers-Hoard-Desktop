{
  "contractVersion": 1,
  "format": "writers-hoard-local-runtime-package/1",
  "tools": [
    {
      "name": "wh_local_package_inspect",
      "group": "research",
      "writes": false,
      "schema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mime": {
                "type": "string",
                "enum": [
                  "application/json",
                  "application/octet-stream"
                ]
              },
              "base64": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "mime",
              "base64"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "file"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "wh_local_package_install",
      "group": "research",
      "writes": true,
      "schema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mime": {
                "type": "string",
                "enum": [
                  "application/json",
                  "application/octet-stream"
                ]
              },
              "base64": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "mime",
              "base64"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "file"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "wh_local_package_list",
      "group": "research",
      "writes": false,
      "schema": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$",
            "maxLength": 80
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "wh_local_package_export",
      "group": "research",
      "writes": false,
      "schema": {
        "type": "object",
        "properties": {
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "contentHash"
        ],
        "additionalProperties": false
      }
    }
  ]
}
