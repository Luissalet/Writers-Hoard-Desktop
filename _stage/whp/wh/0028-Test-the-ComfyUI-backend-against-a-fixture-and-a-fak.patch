+// ============================================================================
+// Critical test — the Bench: ComfyUI as the power backend
+// ============================================================================
+//
+// There is no ComfyUI in this environment, so what is proved here is
+// everything that does not need one: that every shipped template is a valid
+// API-format graph whose node classes and input names exist in ComfyUI's own
+// definitions, that bindings resolve by title and fall back to id, that node
+// ids never move between two submissions of the same recipe (ComfyUI's
+// execution cache is keyed on them), that a missing node pack is reported by
+// pack name and never submitted, and that submit → progress → history → bytes
+// works end to end against a fake server, including when the WebSocket dies.
+
+import txt2imgAsset from '../resources/comfy-templates/txt2img.json';
+import hiresAsset from '../resources/comfy-templates/hires.json';
+import regionalAsset from '../resources/comfy-templates/regional.json';
+import inpaintAsset from '../resources/comfy-templates/inpaint.json';
+import upscaleAsset from '../resources/comfy-templates/ultimate-upscale.json';
+import detailerAsset from '../resources/comfy-templates/detailer.json';
+import controlnetAsset from '../resources/comfy-templates/multi-controlnet.json';
+import {
+  adoptWorkflow,
+  bytesToBase64,
+  buildGraph,
+  checkTemplate,
+  chooseTemplateId,
+  classesUsed,
+  comfySamplerName,
+  comfySchedulerName,
+  createComfyClient,
+  createTemplateRegistry,
+  danglingLinks,
+  discoverInputs,
+  indexObjectInfo,
+  isLink,
+  inputSpec,
+  missingModelMessage,
+  multipartBody,
+  parseDataUrl,
+  planSlots,
+  planSubmission,
+  readComfyExtras,
+  readProgressEvent,
+  resolveBinding,
+  resolveModelName,
+  suggestMapping,
+  webSocketUrl,
+  type ComfyFetch,
+  type ComfyGraph,
+  type ComfyProgress,
+  type ComfyRecipe,
+  type ComfySocketFactory,
+  type ComfySocketHandlers,
+} from '@/services/aiRuntime/comfy';
+import {
+  CHECKPOINTS,
+  CONTROLNETS,
+  DETECTORS,
+  LORAS,
+  UPSCALE_MODELS,
+  comfyObjectInfoFixture,
+} from './comfyFixture';
+
+const ASSETS = [txt2imgAsset, hiresAsset, regionalAsset, inpaintAsset, upscaleAsset, detailerAsset, controlnetAsset];
+
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) throw new Error(message);
+}
+
+/** Key-order-independent JSON, so two equal graphs compare equal. */
+function canonical(value: unknown): string {
+  return JSON.stringify(value, (_key, entry) =>
+    entry && typeof entry === 'object' && !Array.isArray(entry)
+      ? Object.fromEntries(Object.entries(entry as Record<string, unknown>).sort(([a], [b]) => a.localeCompare(b)))
+      : entry,
+  );
+}
+
+const REGISTRY = createTemplateRegistry(ASSETS);
+const INFO = indexObjectInfo(comfyObjectInfoFixture());
+
+function baseRecipe(overrides: Partial<ComfyRecipe> = {}): ComfyRecipe {
+  return {
+    templateId: 'txt2img',
+    checkpoint: CHECKPOINTS[0],
+    prompt: 'a lantern-lit alley',
+    negativePrompt: 'blurry',
+    width: 1024,
+    height: 1024,
+    batchSize: 1,
+    seed: 12345,
+    steps: 25,
+    cfg: 6,
+    samplerName: 'dpmpp_2m',
+    scheduler: 'karras',
+    denoise: 1,
+    filenamePrefix: 'WritersHoard/wh',
+    loras: [],
+    guidance: 'none',
+    ...overrides,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// 1. Every shipped template parses and is a real ComfyUI graph
+// ---------------------------------------------------------------------------
+
+function testTemplatesAreReal(): void {
+  assert(REGISTRY.rejected.length === 0, `a shipped template did not parse: index ${REGISTRY.rejected.join(', ')}`);
+  assert(REGISTRY.all.length === ASSETS.length, 'the registry lost a template');
+
+  for (const template of REGISTRY.all) {
+    const titles = Object.values(template.graph).map((node) => node._meta?.title);
+    assert(titles.every((title) => typeof title === 'string' && title), `${template.id}: a node has no title to bind by`);
+    assert(new Set(titles).size === titles.length, `${template.id}: two nodes share a title, so a binding is ambiguous`);
+    assert(danglingLinks(template.graph).length === 0, `${template.id}: ships with a broken link`);
+
+    for (const [nodeId, node] of Object.entries(template.graph)) {
+      // The class name must be one ComfyUI actually defines. This is the check
+      // that a template invented a node class cannot survive.
+      assert(INFO.classes[node.class_type], `${template.id}: node ${nodeId} uses unknown class "${node.class_type}"`);
+      for (const [input, value] of Object.entries(node.inputs)) {
+        const spec = inputSpec(INFO, node.class_type, input);
+        assert(spec, `${template.id}: ${node.class_type} has no input "${input}"`);
+        if (isLink(value)) continue;
+        // A literal combo value must be an option ComfyUI offers, unless a
+        // binding overwrites it — those are placeholders for a model name.
+        const bound = Object.values(template.bindings).some(
+          (binding) => binding.input === input && (binding.node === nodeId || binding.title === node._meta?.title),
+        );
+        if (spec.options && !bound) {
+          assert(spec.options.includes(String(value)), `${template.id}: ${node.class_type}.${input} = "${String(value)}" is not an option`);
+        }
+      }
+    }
+
+    for (const [key, binding] of Object.entries(template.bindings)) {
+      const resolved = resolveBinding(template.graph, binding);
+      assert(resolved.ok, `${template.id}: binding "${key}" does not resolve (${resolved.ok ? '' : resolved.reason})`);
+    }
+
+    // Availability against a complete install must be clean for all of them.
+    const availability = checkTemplate(template, INFO);
+    assert(availability.ok, `${template.id}: unavailable against a complete install — ${availability.message}`);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 2. Bindings resolve by title first, by id second
+// ---------------------------------------------------------------------------
+
+function testBindingResolution(): void {
+  const graph: ComfyGraph = {
+    '5': { class_type: 'KSampler', _meta: { title: 'Old Sampler' }, inputs: { seed: 0 } },
+    '9': { class_type: 'KSampler', _meta: { title: 'Sampler' }, inputs: { seed: 0 } },
+  };
+  // A re-exported workflow renumbers nodes; the title is what survives, so it
+  // must beat a stale id rather than the other way round.
+  const byTitle = resolveBinding(graph, { title: 'Sampler', node: '5', input: 'seed' });
+  assert(byTitle.ok && byTitle.node === '9', 'a binding did not prefer the title over the id');
+
+  const byId = resolveBinding(graph, { title: 'Nothing Called This', node: '5', input: 'seed' });
+  assert(byId.ok && byId.node === '5', 'a binding did not fall back to the node id');
+
+  const nowhere = resolveBinding(graph, { title: 'Nothing', node: '404', input: 'seed' });
+  assert(!nowhere.ok && /no node/.test(nowhere.reason), 'an unresolvable binding did not say so');
+
+  const wrongInput = resolveBinding(graph, { node: '9', input: 'not_an_input' });
+  assert(!wrongInput.ok && /has no input/.test(wrongInput.reason), 'a binding to a missing input was accepted');
+
+  // Two nodes with the same title resolve to the same one every time.
+  const ambiguous: ComfyGraph = {
+    '2': { class_type: 'CLIPTextEncode', _meta: { title: 'Positive' }, inputs: { text: '' } },
+    '1': { class_type: 'CLIPTextEncode', _meta: { title: 'Positive' }, inputs: { text: '' } },
+  };
+  const first = resolveBinding(ambiguous, { title: 'Positive', input: 'text' });
+  const second = resolveBinding(ambiguous, { title: 'Positive', input: 'text' });
+  assert(first.ok && second.ok && first.node === second.node && first.node === '1', 'a duplicate title resolved non-deterministically');
+}
+
+// ---------------------------------------------------------------------------
+// 3. Node ids are stable across submissions — the execution cache depends on it
+// ---------------------------------------------------------------------------
+
+function testNodeIdsAreStable(): void {
+  const template = REGISTRY.byId('regional');
+  assert(template, 'the regional template is missing');
+  const recipe = baseRecipe({
+    templateId: 'regional',
+    guidance: 'coherent',
+    loras: [{ name: LORAS[0], weight: 0.8 }, { name: LORAS[1], weight: 0.6 }],
+    regions: [
+      { prompt: 'Mara, left', mask: 'writers-hoard/left.png', strength: 1 },
+      { prompt: 'Aldo, right', mask: 'writers-hoard/right.png', strength: 1 },
+    ],
+  });
+  const first = buildGraph(template, recipe);
+  const second = buildGraph(template, { ...recipe });
+  assert(first.ok && second.ok, 'the regional recipe did not build');
+  assert(canonical(first.graph) === canonical(second.graph), 'two builds of one recipe produced different graphs');
+
+  const ids = Object.keys(first.graph).sort();
+  const templateIds = new Set(Object.keys(template.graph));
+  assert(ids.every((id) => templateIds.has(id)), 'the build invented a node id that is not in the template');
+
+  // A third region reuses the first two regions' ids: adding one must not
+  // renumber what was already cached.
+  const wider = buildGraph(template, {
+    ...recipe,
+    regions: [...(recipe.regions ?? []), { prompt: 'a cat', mask: 'writers-hoard/cat.png', strength: 0.9 }],
+  });
+  assert(wider.ok, 'a three-region recipe did not build');
+  for (const id of ids) {
+    assert(wider.graph[id], `adding a region dropped node ${id}`);
+  }
+  // And the ones that were already there keep the same class and title.
+  for (const id of ids) {
+    assert(wider.graph[id].class_type === first.graph[id].class_type, `node ${id} changed class when a region was added`);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 4. Pruning: unused occurrences are removed, and the chain closes over them
+// ---------------------------------------------------------------------------
+
+function testPruning(): void {
+  const template = REGISTRY.byId('txt2img');
+  assert(template, 'txt2img is missing');
+
+  const bare = buildGraph(template, baseRecipe());
+  assert(bare.ok, 'the bare recipe did not build');
+  assert(!Object.keys(bare.graph).some((id) => ['10', '11', '12', '13', '20', '21', '22', '23'].includes(id)), 'an unused LoRA or guidance node survived');
+  const sampler = bare.graph['5'];
+  assert(isLink(sampler.inputs.model) && sampler.inputs.model[0] === '1', 'with no LoRA and no guidance the sampler must read the checkpoint');
+  assert(isLink(bare.graph['2'].inputs.clip) && bare.graph['2'].inputs.clip[0] === '1', 'the text encoder must fall back to the checkpoint CLIP');
+  assert(danglingLinks(bare.graph).length === 0, 'pruning left a dangling link');
+
+  const twoLoras = buildGraph(template, baseRecipe({ loras: [{ name: LORAS[0], weight: 1 }, { name: LORAS[1], weight: 0.5 }] }));
+  assert(twoLoras.ok, 'a two-LoRA recipe did not build');
+  assert(twoLoras.graph['10'] && twoLoras.graph['11'] && !twoLoras.graph['12'], 'the LoRA chain was not trimmed to two');
+  assert(isLink(twoLoras.graph['5'].inputs.model) && (twoLoras.graph['5'].inputs.model as [string, number])[0] === '11', 'the sampler did not follow the shortened LoRA chain');
+  assert(twoLoras.graph['10'].inputs.lora_name === LORAS[0], 'the first LoRA name was not bound');
+  assert(twoLoras.graph['11'].inputs.strength_model === 0.5, 'the second LoRA weight was not bound');
+
+  // Guidance presets keep a named subset of the chain and nothing else.
+  const coherent = buildGraph(template, baseRecipe({ guidance: 'coherent' }));
+  assert(coherent.ok && coherent.graph['20'] && !coherent.graph['21'] && !coherent.graph['22'] && !coherent.graph['23'], 'the Coherent preset kept the wrong nodes');
+  assert(coherent.graph['20'].class_type === 'PerturbedAttentionGuidance', 'Coherent must be perturbed-attention guidance');
+  const detailed = buildGraph(template, baseRecipe({ guidance: 'detailed' }));
+  assert(detailed.ok && !detailed.graph['20'] && detailed.graph['21'] && detailed.graph['22'] && !detailed.graph['23'], 'the Detailed preset kept the wrong nodes');
+  assert(isLink(detailed.graph['21'].inputs.model) && (detailed.graph['21'].inputs.model as [string, number])[0] === '1', 'a kept guidance node did not close over the removed ones');
+  const distilled = buildGraph(template, baseRecipe({ guidance: 'distilled-negatives' }));
+  assert(distilled.ok && distilled.graph['23'] && !distilled.graph['20'], 'the distilled preset kept the wrong nodes');
+
+  // planSlots is what decides all of that, and it must never exceed the
+  // occurrences a template actually ships.
+  const plan = planSlots(template, baseRecipe({ loras: Array.from({ length: 9 }, () => ({ name: LORAS[0], weight: 1 })) }));
+  assert(plan.lora.length === 4, 'more LoRAs were planned than the template has slots for');
+}
+
+// ---------------------------------------------------------------------------
+// 5. Degradation: a missing pack is named, and nothing is submitted
+// ---------------------------------------------------------------------------
+
+function testMissingPackIsNamed(): void {
+  const withoutImpact = indexObjectInfo(comfyObjectInfoFixture({ omit: ['FaceDetailer', 'UltralyticsDetectorProvider'] }));
+  const template = REGISTRY.byId('detailer');
+  assert(template, 'the detailer template is missing');
+  const availability = checkTemplate(template, withoutImpact);
+  assert(!availability.ok, 'a template whose pack is missing reported itself available');
+  assert(/ComfyUI-Impact-Pack/.test(availability.message), 'the remedy did not name ComfyUI-Impact-Pack');
+  assert(/ComfyUI-Impact-Subpack/.test(availability.message), 'the remedy did not name ComfyUI-Impact-Subpack');
+  assert(!/FaceDetailer/.test(availability.message), 'the user was shown a raw node class name');
+
+  const recipe = baseRecipe({
+    templateId: 'detailer',
+    sourceImage: 'writers-hoard/source.png',
+    detail: [{ detector: DETECTORS[0], prompt: 'her face', denoise: 0.4 }],
+  });
+  const plan = planSubmission(REGISTRY, withoutImpact, recipe);
+  assert(!plan.ok, 'a plan against a ComfyUI without the pack was allowed to submit');
+  assert(!plan.ok && /ComfyUI-Impact-Pack/.test(plan.error), 'the refusal did not name the pack');
+
+  // A recipe that carries something the chosen template has nowhere to put
+  // must be refused, not quietly rendered without it.
+  const regionsOnATemplateWithout = planSubmission(REGISTRY, INFO, baseRecipe({
+    templateId: 'txt2img',
+    regions: [{ prompt: 'left', mask: 'writers-hoard/left.png', strength: 1 }],
+  }));
+  assert(!regionsOnATemplateWithout.ok && /masked regions/.test(regionsOnATemplateWithout.error), 'regions were silently dropped');
+  const maskWithoutAnInpaint = planSubmission(REGISTRY, INFO, baseRecipe({ templateId: 'txt2img', maskImage: 'writers-hoard/mask.png' }));
+  assert(!maskWithoutAnInpaint.ok && /mask/.test(maskWithoutAnInpaint.error), 'a mask was silently dropped');
+  const controlsOnRegional = planSubmission(REGISTRY, INFO, baseRecipe({
+    templateId: 'regional',
+    regions: [{ prompt: 'left', mask: 'writers-hoard/left.png', strength: 1 }],
+    controls: [{ model: CONTROLNETS[0], image: 'writers-hoard/pose.png', strength: 1, startPercent: 0, endPercent: 1 }],
+  }));
+  assert(!controlsOnRegional.ok && /ControlNets/.test(controlsOnRegional.error), 'combining regions and ControlNets was not refused');
+
+  // A core class missing means the install is old, not that a pack is needed.
+  const ancient = indexObjectInfo(comfyObjectInfoFixture({ omit: ['ConditioningSetMask'] }));
+  const regional = REGISTRY.byId('regional');
+  assert(regional, 'the regional template is missing');
+  const old = checkTemplate(regional, ancient);
+  assert(!old.ok && /Update ComfyUI/.test(old.message), 'a missing core node did not read as an out-of-date ComfyUI');
+
+  // Guidance nodes are optional, so a build without them must still refuse
+  // explicitly rather than quietly dropping the preset the user picked.
+  const noPag = indexObjectInfo(comfyObjectInfoFixture({ omit: ['PerturbedAttentionGuidance'] }));
+  const guided = planSubmission(REGISTRY, noPag, baseRecipe({ guidance: 'coherent' }));
+  assert(!guided.ok && /PerturbedAttentionGuidance|Update ComfyUI/.test(guided.error), 'a missing guidance node was silently ignored');
+  const ungui = planSubmission(REGISTRY, noPag, baseRecipe({ guidance: 'none' }));
+  assert(ungui.ok, 'a recipe that does not use guidance was refused for a missing guidance node');
+}
+
+// ---------------------------------------------------------------------------
+// 6. A model a recipe names but the install does not have
+// ---------------------------------------------------------------------------
+
+function testMissingModels(): void {
+  const plan = planSubmission(REGISTRY, INFO, baseRecipe({ checkpoint: 'not-installed.safetensors' }));
+  assert(!plan.ok && plan.code === 'model-missing', 'a missing checkpoint was not refused');
+  assert(!plan.ok && /not-installed\.safetensors/.test(plan.error), 'the refusal did not say which checkpoint');
+
+  // The same file in a different folder is the common case, and the nearest
+  // match must be offered rather than substituted.
+  const nearby = resolveModelName('juggernautXL_v9.safetensors', CHECKPOINTS);
+  assert(nearby.exact === null && nearby.nearest === CHECKPOINTS[0], 'the same file in another folder was not recognised');
+  const exact = resolveModelName(CHECKPOINTS[1], CHECKPOINTS);
+  assert(exact.exact === CHECKPOINTS[1], 'an installed checkpoint was not matched exactly');
+  const nonsense = resolveModelName('zzz-unrelated-thing.safetensors', CHECKPOINTS);
+  assert(nonsense.nearest === null, 'an unrelated name was offered as a substitute');
+  assert(/nearest one installed/.test(missingModelMessage('checkpoint', 'juggernautXL_v9.safetensors', CHECKPOINTS)), 'the nearest match was not offered');
+
+  const lora = planSubmission(REGISTRY, INFO, baseRecipe({ loras: [{ name: 'ghost.safetensors', weight: 1 }] }));
+  assert(!lora.ok && /ghost\.safetensors/.test(lora.error), 'a missing LoRA was not named');
+
+  const control = planSubmission(REGISTRY, INFO, baseRecipe({
+    templateId: 'multi-controlnet',
+    controls: [{ model: 'missing-cn.safetensors', image: 'writers-hoard/pose.png', strength: 0.8, startPercent: 0, endPercent: 0.7 }],
+  }));
+  assert(!control.ok && /missing-cn/.test(control.error), 'a missing ControlNet was not named');
+}
+
+// ---------------------------------------------------------------------------
+// 7. The graphs the harder templates produce
+// ---------------------------------------------------------------------------
+
+function testHarderTemplates(): void {
+  const controlnet = REGISTRY.byId('multi-controlnet');
+  assert(controlnet, 'multi-controlnet is missing');
+  const stacked = buildGraph(controlnet, baseRecipe({
+    templateId: 'multi-controlnet',
+    controls: [
+      { model: CONTROLNETS[0], image: 'writers-hoard/pose.png', strength: 0.9, startPercent: 0, endPercent: 0.7 },
+      { model: CONTROLNETS[1], image: 'writers-hoard/depth.png', strength: 0.5, startPercent: 0.1, endPercent: 0.9 },
+    ],
+  }));
+  assert(stacked.ok, 'a two-ControlNet recipe did not build');
+  assert(stacked.graph['151'] && stacked.graph['152'] && !stacked.graph['153'], 'the ControlNet chain was not trimmed to two');
+  assert(isLink(stacked.graph['5'].inputs.positive) && (stacked.graph['5'].inputs.positive as [string, number])[0] === '152', 'the sampler did not read the last kept ControlNet');
+  assert(isLink(stacked.graph['5'].inputs.negative) && (stacked.graph['5'].inputs.negative as [string, number])[1] === 1, 'the negative must come from the ControlNet second output');
+  assert(stacked.graph['152'].inputs.end_percent === 0.9, 'a ControlNet end percent was not bound');
+
+  const inpaint = REGISTRY.byId('inpaint');
+  assert(inpaint, 'inpaint is missing');
+  const masked = buildGraph(inpaint, baseRecipe({
+    templateId: 'inpaint',
+    sourceImage: 'writers-hoard/source.png',
+    maskImage: 'writers-hoard/mask.png',
+    crop: { x: 240, y: 130, width: 384, height: 384 },
+    workWidth: 1024,
+    workHeight: 1024,
+    growMaskBy: 6,
+  }));
+  assert(masked.ok, 'an inpaint recipe did not build');
+  // "Only masked" is four numbers that must agree: cut here, work at this
+  // size, scale back to the cut, paste it where it came from.
+  assert(masked.graph['72'].inputs.x === 240 && masked.graph['74'].inputs.x === 240, 'the source and mask crops disagree');
+  assert(masked.graph['73'].inputs.width === 1024 && masked.graph['75'].inputs.width === 1024, 'the work size was not applied to both crops');
+  assert(masked.graph['78'].inputs.width === 384 && masked.graph['78'].inputs.height === 384, 'the result was not scaled back to the crop');
+  assert(masked.graph['79'].inputs.x === 240 && masked.graph['79'].inputs.y === 130, 'the composite pastes in the wrong place');
+
+  const upscale = REGISTRY.byId('ultimate-upscale');
+  assert(upscale, 'ultimate-upscale is missing');
+  const tiled = buildGraph(upscale, baseRecipe({
+    templateId: 'ultimate-upscale',
+    sourceImage: 'writers-hoard/source.png',
+    upscale: { model: UPSCALE_MODELS[0], by: 2, denoise: 0.2, tileWidth: 512, tileHeight: 512 },
+  }));
+  assert(tiled.ok, 'an upscale recipe did not build');
+  assert(tiled.graph['91'].inputs.denoise === 0.2, 'Ultimate SD Upscale must ship at denoise 0.2');
+  assert(tiled.graph['91'].inputs.mode_type === 'Chess', 'Ultimate SD Upscale must ship in chess mode');
+  assert(tiled.graph['91'].inputs.seam_fix_mode === 'Half Tile', 'Ultimate SD Upscale must ship with seam fixing on');
+
+  const detailer = REGISTRY.byId('detailer');
+  assert(detailer, 'detailer is missing');
+  const twoStages = buildGraph(detailer, baseRecipe({
+    templateId: 'detailer',
+    sourceImage: 'writers-hoard/source.png',
+    detail: [
+      { detector: DETECTORS[0], prompt: 'her face', denoise: 0.4 },
+      { detector: DETECTORS[1], prompt: 'her hands', denoise: 0.35 },
+    ],
+  }));
+  assert(twoStages.ok, 'a two-stage detail chain did not build');
+  assert(twoStages.graph['101'] && twoStages.graph['111'] && !twoStages.graph['121'], 'the detail chain was not trimmed to two stages');
+  assert(isLink(twoStages.graph['7'].inputs.images) && (twoStages.graph['7'].inputs.images as [string, number])[0] === '111', 'the output did not follow the shortened detail chain');
+  assert(twoStages.graph['101'].inputs.segm_detector_opt === undefined, 'a bbox detector must not be wired to the segmentation input');
+
+  const segm = buildGraph(detailer, baseRecipe({
+    templateId: 'detailer',
+    sourceImage: 'writers-hoard/source.png',
+    detail: [{ detector: DETECTORS[2], prompt: 'the figure', denoise: 0.4 }],
+  }));
+  assert(segm.ok, 'a segmentation detail stage did not build');
+  const wired = segm.graph['101'].inputs.segm_detector_opt;
+  assert(isLink(wired) && wired[0] === '100' && wired[1] === 1, 'a segm detector was not wired to the segmentation input');
+
+  const hires = REGISTRY.byId('hires');
+  assert(hires, 'hires is missing');
+  const twoPass = buildGraph(hires, baseRecipe({ templateId: 'hires', hires: { width: 1536, height: 1536, steps: 12, denoise: 0.45 } }));
+  assert(twoPass.ok, 'a hires recipe did not build');
+  assert(twoPass.graph['8'].inputs.width === 1536 && twoPass.graph['9'].inputs.denoise === 0.45, 'the hires pass was not bound');
+  assert(isLink(twoPass.graph['6'].inputs.samples) && (twoPass.graph['6'].inputs.samples as [string, number])[0] === '9', 'the decode must read the second pass');
+
+  for (const built of [stacked, masked, tiled, twoStages, segm, twoPass]) {
+    assert(built.ok && danglingLinks(built.graph).length === 0, 'a built graph has a dangling link');
+    assert(built.ok && classesUsed(built.graph).every((className) => INFO.classes[className]), 'a built graph uses a class ComfyUI does not define');
+  }
+}
