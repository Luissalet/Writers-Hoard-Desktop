+// ---------------------------------------------------------------------------
+// 10. The transport, against a fake ComfyUI
+// ---------------------------------------------------------------------------
+
+const PNG_BYTES = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4]);
+
+interface FakeServer {
+  fetch: ComfyFetch;
+  calls: string[];
+  submitted: ComfyGraph | null;
+  ready: boolean;
+  readyAfterHistoryCalls: number;
+  rejectPrompt: string | null;
+  /** Fires while the first /history call is in flight. */
+  onFirstHistory: (() => void) | null;
+}
+
+function createFakeServer(): FakeServer {
+  const server: FakeServer = {
+    calls: [],
+    submitted: null,
+    ready: false,
+    readyAfterHistoryCalls: 0,
+    rejectPrompt: null,
+    onFirstHistory: null,
+    fetch: async () => new Response(null, { status: 500 }),
+  };
+  let historyCalls = 0;
+  server.fetch = async (url, init) => {
+    const path = url.replace('http://127.0.0.1:8188', '');
+    server.calls.push(`${init?.method ?? 'GET'} ${path.split('?')[0]}`);
+    if (path.startsWith('/object_info')) {
+      return new Response(JSON.stringify(comfyObjectInfoFixture()), { status: 200 });
+    }
+    if (path.startsWith('/system_stats')) {
+      return new Response(JSON.stringify({ system: { ram_total: 32e9, ram_free: 20e9, comfyui_version: '0.3.0' }, devices: [{ name: 'cuda:0 RTX 4070 Ti', vram_total: 12.8e9, vram_free: 11e9 }] }), { status: 200 });
+    }
+    if (path.startsWith('/upload/image')) {
+      return new Response(JSON.stringify({ name: 'wh-abc.png', subfolder: 'writers-hoard', type: 'input' }), { status: 200 });
+    }
+    if (path.startsWith('/prompt')) {
+      if (server.rejectPrompt) {
+        return new Response(
+          JSON.stringify({
+            error: { type: 'prompt_outputs_failed_validation', message: 'Prompt outputs failed validation' },
+            node_errors: { '1': { errors: [{ type: 'value_not_in_list', message: 'Value not in list', details: server.rejectPrompt }] } },
+          }),
+          { status: 400 },
+        );
+      }
+      server.submitted = JSON.parse(String(init?.body)).prompt as ComfyGraph;
+      return new Response(JSON.stringify({ prompt_id: 'p1', number: 1, node_errors: {} }), { status: 200 });
+    }
+    if (path.startsWith('/history/')) {
+      historyCalls += 1;
+      if (historyCalls === 1) server.onFirstHistory?.();
+      if (server.readyAfterHistoryCalls && historyCalls >= server.readyAfterHistoryCalls) server.ready = true;
+      if (!server.ready) return new Response('{}', { status: 200 });
+      return new Response(
+        JSON.stringify({
+          p1: {
+            outputs: { '7': { images: [{ filename: 'wh_00001_.png', subfolder: 'WritersHoard', type: 'output' }] } },
+            status: { status_str: 'success', completed: true },
+          },
+        }),
+        { status: 200 },
+      );
+    }
+    if (path.startsWith('/view')) {
+      return new Response(PNG_BYTES, { status: 200 });
+    }
+    if (path.startsWith('/interrupt') || path.startsWith('/queue')) return new Response('', { status: 200 });
+    return new Response('nope', { status: 404 });
+  };
+  return server;
+}
+
+function scriptedSocket(script: (handlers: ComfySocketHandlers) => void): ComfySocketFactory {
+  return (_url, handlers) => {
+    setTimeout(() => script(handlers), 0);
+    return { close: () => undefined };
+  };
+}
+
+async function testTransportRoundTrip(): Promise<void> {
+  const server = createFakeServer();
+  const progress: ComfyProgress[] = [];
+  const client = createComfyClient({
+    baseUrl: 'http://127.0.0.1:8188/',
+    clientId: 'client-1',
+    fetch: server.fetch,
+    // A long poll interval: if the run only finishes because the socket woke
+    // it, this test proves the socket is doing its job.
+    pollIntervalMs: 30_000,
+    openSocket: scriptedSocket((handlers) => {
+      handlers.onMessage(JSON.stringify({ type: 'progress', data: { value: 5, max: 20, prompt_id: 'p1', node: '5' } }));
+      handlers.onMessage(JSON.stringify({ type: 'progress', data: { value: 20, max: 20, prompt_id: 'p1', node: '5' } }));
+      // An event for someone else's submission must not end ours.
+      handlers.onMessage(JSON.stringify({ type: 'executing', data: { node: null, prompt_id: 'someone-else' } }));
+      server.ready = true;
+      handlers.onMessage(JSON.stringify({ type: 'executing', data: { node: null, prompt_id: 'p1' } }));
+    }),
+  });
+
+  const info = await client.objectInfo();
+  assert(info.classes.KSampler, 'the fake /object_info did not come back indexed');
+
+  const template = REGISTRY.byId('txt2img');
+  assert(template, 'txt2img is missing');
+  const plan = planSubmission(REGISTRY, info, baseRecipe());
+  assert(plan.ok, 'the plan against the fake server failed');
+  const promptId = await client.submit(plan.graph);
+  assert(promptId === 'p1', 'the prompt id did not come back');
+  assert(server.submitted && canonical(server.submitted) === canonical(plan.graph), 'the graph on the wire is not the graph that was built');
+
+  const entry = await client.awaitResult(promptId, { onProgress: (event) => progress.push(event) });
+  assert(progress.length >= 2 && progress[0].fraction === 0.25 && progress[1].fraction === 1, 'progress did not arrive as fractions');
+  const refs = Object.values(entry.outputs).flatMap((output) => output.images ?? []);
+  assert(refs.length === 1 && refs[0].filename === 'wh_00001_.png', 'the history did not name the output file');
+  const bytes = await client.view(refs[0]);
+  assert(bytes.length === PNG_BYTES.length && bytes[1] === 0x50, 'the image bytes did not come back');
+  assert(bytesToBase64(bytes) === bytesToBase64(PNG_BYTES), 'the base64 conversion is not faithful');
+  // Nothing may have been polled more than twice: the socket ended the wait.
+  const historyCalls = server.calls.filter((call) => call.startsWith('GET /history/')).length;
+  assert(historyCalls <= 2, `the socket did not shorten the wait (${historyCalls} history polls)`);
+
+  const stats = await client.systemStats();
+  assert(stats.devices[0]?.vramFree === 11e9, 'the VRAM report did not come back');
+}
+
+async function testAnEarlyWakeIsNotLost(): Promise<void> {
+  // "The queue item finished" routinely arrives while the poll it should
+  // shorten is still in flight. An edge-triggered wake would be dropped there
+  // and the run would sit out a whole poll interval for nothing, so the wake
+  // has to latch. A sleep that is never called is the proof.
+  const server = createFakeServer();
+  let sleeps = 0;
+  let handlers: ComfySocketHandlers | null = null;
+  server.onFirstHistory = () => {
+    // Ready only from the SECOND poll, so the first one must come back empty
+    // and the wake has to survive until the wait that follows it.
+    server.readyAfterHistoryCalls = 2;
+    handlers?.onMessage(JSON.stringify({ type: 'execution_success', data: { prompt_id: 'p1' } }));
+  };
+  const client = createComfyClient({
+    baseUrl: 'http://127.0.0.1:8188',
+    clientId: 'client-7',
+    fetch: server.fetch,
+    pollIntervalMs: 30_000,
+    sleep: () => {
+      sleeps += 1;
+      return Promise.resolve();
+    },
+    openSocket: (_url, incoming) => {
+      handlers = incoming;
+      return { close: () => undefined };
+    },
+  });
+  const entry = await client.awaitResult('p1', {});
+  assert(Object.keys(entry.outputs).length === 1, 'the run did not finish');
+  assert(sleeps === 0, 'a wake that arrived mid-poll was lost, so the run waited for nothing');
+}
+
+async function testPollingWhenTheSocketIsGone(): Promise<void> {
+  // No socket at all: an older runtime, or a proxy that eats WebSockets.
+  const server = createFakeServer();
+  server.readyAfterHistoryCalls = 3;
+  const noSocket = createComfyClient({
+    baseUrl: 'http://127.0.0.1:8188',
+    clientId: 'client-2',
+    fetch: server.fetch,
+    pollIntervalMs: 1,
+    sleep: () => Promise.resolve(),
+  });
+  const entry = await noSocket.awaitResult('p1', {});
+  assert(Object.keys(entry.outputs).length === 1, 'polling did not reach the outputs');
+  assert(server.calls.filter((call) => call.startsWith('GET /history/')).length >= 3, 'the poll did not actually run');
+
+  // A socket that opens and immediately dies must degrade to the same poll.
+  const dropped = createFakeServer();
+  dropped.readyAfterHistoryCalls = 2;
+  const client = createComfyClient({
+    baseUrl: 'http://127.0.0.1:8188',
+    clientId: 'client-3',
+    fetch: dropped.fetch,
+    pollIntervalMs: 1,
+    sleep: () => Promise.resolve(),
+    openSocket: (_url, handlers) => {
+      setTimeout(() => handlers.onClose(), 0);
+      return { close: () => undefined };
+    },
+  });
+  const second = await client.awaitResult('p1', {});
+  assert(Object.keys(second.outputs).length === 1, 'a dropped socket did not fall back to polling');
+}
+
+async function testCancelAndFailure(): Promise<void> {
+  const server = createFakeServer();
+  const controller = new AbortController();
+  const client = createComfyClient({
+    baseUrl: 'http://127.0.0.1:8188',
+    clientId: 'client-4',
+    fetch: server.fetch,
+    pollIntervalMs: 1,
+    sleep: (ms) => new Promise((resolve) => setTimeout(resolve, ms)),
+  });
+  setTimeout(() => controller.abort('cancelled'), 5);
+  let cancelled = false;
+  try {
+    await client.awaitResult('p1', { signal: controller.signal });
+  } catch (err) {
+    cancelled = err instanceof Error && /Cancelled/.test(err.message);
+  }
+  assert(cancelled, 'an aborted wait did not end as cancelled');
+
+  await client.cancel('p1');
+  assert(server.calls.includes('POST /interrupt'), 'cancel did not interrupt the running job');
+  // A job that has not started yet is not interrupted by /interrupt: it has to
+  // come out of the queue, or it starts a minute later as if nothing happened.
+  assert(server.calls.includes('POST /queue'), 'cancel did not remove the job from the queue');
+
+  // A rejected prompt must name the node and the reason.
+  server.rejectPrompt = "ckpt_name: 'ghost.safetensors' not in (list of length 2)";
+  let rejection = '';
+  try {
+    await client.submit({ '1': { class_type: 'CheckpointLoaderSimple', inputs: { ckpt_name: 'ghost.safetensors' } } });
+  } catch (err) {
+    rejection = err instanceof Error ? err.message : '';
+  }
+  assert(/node 1/.test(rejection) && /ghost\.safetensors/.test(rejection), `a rejected prompt was not explained: ${rejection}`);
+
+  // An execution error on the socket ends the wait rather than hanging to the
+  // timeout with a progress bar that never moves.
+  const failing = createFakeServer();
+  const failClient = createComfyClient({
+    baseUrl: 'http://127.0.0.1:8188',
+    clientId: 'client-5',
+    fetch: failing.fetch,
+    pollIntervalMs: 50,
+    openSocket: scriptedSocket((handlers) => {
+      handlers.onMessage(JSON.stringify({ type: 'execution_error', data: { prompt_id: 'p1', node_id: '5', exception_message: 'CUDA out of memory' } }));
+    }),
+  });
+  let failure = '';
+  try {
+    await failClient.awaitResult('p1', {});
+  } catch (err) {
+    failure = err instanceof Error ? err.message : '';
+  }
+  assert(/CUDA out of memory/.test(failure), `an execution error was not surfaced: ${failure}`);
+}
