+async function testUploads(): Promise<void> {
+  const server = createFakeServer();
+  const client = createComfyClient({ baseUrl: 'http://127.0.0.1:8188', clientId: 'client-6', fetch: server.fetch });
+  const uploaded = await client.uploadImage({ bytes: PNG_BYTES, fileName: 'wh-1.png', contentType: 'image/png' });
+  assert(uploaded.name === 'wh-abc.png' && uploaded.subfolder === 'writers-hoard', 'the upload result was not read');
+
+  const { contentType, body } = multipartBody(
+    [{ name: 'type', value: 'input' }, { name: 'image', fileName: 'a.png', contentType: 'image/png', bytes: PNG_BYTES }],
+    'BOUNDARY',
+  );
+  const text = new TextDecoder('latin1').decode(body);
+  assert(contentType === 'multipart/form-data; boundary=BOUNDARY', 'the multipart content type is wrong');
+  assert(text.includes('Content-Disposition: form-data; name="type"'), 'a multipart field is missing');
+  assert(text.includes('filename="a.png"') && text.includes('Content-Type: image/png'), 'the multipart file part is malformed');
+  assert(text.endsWith('--BOUNDARY--\r\n'), 'the multipart body is not terminated');
+
+  const parsed = parseDataUrl('data:image/png;base64,iVBORw0KGgo=');
+  assert(parsed && parsed.contentType === 'image/png' && parsed.bytes[0] === 0x89, 'a data URL did not decode');
+  assert(parseDataUrl('not a data url') === null, 'a bad data URL was accepted');
+
+  assert(webSocketUrl('http://127.0.0.1:8188/', 'abc') === 'ws://127.0.0.1:8188/ws?clientId=abc', 'the WebSocket URL is wrong');
+  assert(webSocketUrl('https://comfy.example.com', 'abc').startsWith('wss://'), 'https did not become wss');
+
+  // Both progress shapes ComfyUI has shipped reduce to the same fraction.
+  const old = readProgressEvent('progress', { value: 3, max: 12, node: '5' });
+  assert(old?.fraction === 0.25, 'the legacy progress event was not read');
+  const modern = readProgressEvent('progress_state', {
+    prompt_id: 'p1',
+    nodes: { '5': { value: 3, max: 12, state: 'running' }, '6': { value: 0, max: 0, state: 'pending' } },
+  });
+  assert(modern?.fraction === 0.25 && modern.node === '5', 'the progress_state event was not read');
+}
