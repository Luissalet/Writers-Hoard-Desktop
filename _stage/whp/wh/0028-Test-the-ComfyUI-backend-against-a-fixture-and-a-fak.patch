+function testPlanningSurface(): void {
+  assert(chooseTemplateId({ regions: 0, controls: 0, detailStages: 0, hasSource: false, hasMask: false, wantsUpscale: false, wantsHires: false }) === 'txt2img', 'a plain request is not txt2img');
+  assert(chooseTemplateId({ regions: 2, controls: 0, detailStages: 0, hasSource: false, hasMask: false, wantsUpscale: false, wantsHires: false }) === 'regional', 'regions did not choose the regional template');
+  assert(chooseTemplateId({ regions: 0, controls: 0, detailStages: 0, hasSource: true, hasMask: true, wantsUpscale: false, wantsHires: false }) === 'inpaint', 'a source plus a mask is not an inpaint');
+  assert(chooseTemplateId({ regions: 0, controls: 0, detailStages: 0, hasSource: true, hasMask: false, wantsUpscale: true, wantsHires: false }) === 'ultimate-upscale', 'an upscale was not chosen');
+  assert(chooseTemplateId({ regions: 0, controls: 0, detailStages: 2, hasSource: true, hasMask: false, wantsUpscale: false, wantsHires: false }) === 'detailer', 'a detail chain was not chosen');
+  assert(chooseTemplateId({ regions: 0, controls: 0, detailStages: 0, hasSource: false, hasMask: false, wantsUpscale: false, wantsHires: true }) === 'hires', 'a hires request was not chosen');
+  // An upscale with nothing to upscale must not silently become an upscale.
+  assert(chooseTemplateId({ regions: 0, controls: 0, detailStages: 0, hasSource: false, hasMask: false, wantsUpscale: true, wantsHires: false }) === 'txt2img', 'an upscale with no source was chosen anyway');
+
+  // Extras are read defensively: a region with no mask is not a region.
+  const extras = readComfyExtras({
+    comfy: {
+      guidance: 'coherent',
+      regions: [
+        { prompt: 'left', maskDataUrl: 'data:image/png;base64,AAA=', strength: 3 },
+        { prompt: 'no mask here' },
+      ],
+      controls: [{ model: CONTROLNETS[0], imageDataUrl: 'data:image/png;base64,AAA=', startPercent: 0.8, endPercent: 0.2 }],
+      detail: [{ prompt: 'nothing to detect' }],
+      upscale: { model: UPSCALE_MODELS[0], by: 99 },
+    },
+  });
+  assert(extras.guidance === 'coherent', 'a valid guidance preset was dropped');
+  assert(extras.regions.length === 1, 'a region without a mask was kept');
+  assert(extras.detail.length === 0, 'a detail stage without a detector was kept');
+  assert(extras.controls[0].startPercent === 0.2 && extras.controls[0].endPercent === 0.8, 'a reversed percent range was not put back in order');
+  assert(extras.upscale?.by === 4, 'an out-of-range upscale factor was not clamped');
+  assert(readComfyExtras({}).guidance === 'none', 'a request with no extras did not read as none');
+  assert(readComfyExtras({ comfy: { guidance: 'nonsense' } }).guidance === 'none', 'an unknown guidance preset was accepted');
+
+  // The app's sampler names are stable-diffusion.cpp's; ComfyUI's are not.
+  const samplers = ['euler', 'euler_ancestral', 'dpmpp_2m', 'dpmpp_2s_ancestral'];
+  assert(comfySamplerName('euler_a', samplers) === 'euler_ancestral', 'euler_a was not translated');
+  assert(comfySamplerName('dpm++2m', samplers) === 'dpmpp_2m', 'dpm++2m was not translated');
+  assert(comfySamplerName('dpmpp_2m', samplers) === 'dpmpp_2m', 'a name that is already ComfyUI-s was changed');
+  assert(comfySamplerName('tcd', samplers) === 'euler', 'a sampler this build does not have did not fall back');
+  assert(comfySchedulerName('discrete', ['normal', 'karras']) === 'normal', 'the discrete scheduler was not translated');
+  assert(comfySchedulerName('karras', ['normal', 'karras']) === 'karras', 'karras was not kept');
+  assert(comfySchedulerName('bong_tangent', ['normal', 'karras']) === 'normal', 'an unknown scheduler did not fall back');
