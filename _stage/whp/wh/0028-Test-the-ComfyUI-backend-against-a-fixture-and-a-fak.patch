+function testBringYourOwnWorkflow(): void {
+  const template = REGISTRY.byId('txt2img');
+  assert(template, 'txt2img is missing');
+  const found = discoverInputs(template.graph, INFO);
+  const has = (nodeClass: string, input: string): boolean => found.some((entry) => entry.classType === nodeClass && entry.input === input);
