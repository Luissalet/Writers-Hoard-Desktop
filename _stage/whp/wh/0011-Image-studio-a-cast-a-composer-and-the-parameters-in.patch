+            <button
+              key={dialect}
+              type="button"
+              onClick={() => onChange({ dialect })}
+              className={`px-2 py-0.5 rounded text-[10px] border transition ${
+                visual.dialect === dialect
+                  ? 'border-accent-gold/50 bg-accent-gold/15 text-accent-gold'
