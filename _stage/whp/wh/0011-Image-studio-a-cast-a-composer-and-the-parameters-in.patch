+import type { PromptDialect, VisualRef, VisualRefKind } from '@/types/visualRef';
+import { generateId } from '@/utils/idGenerator';
+import { stripHtml } from '@/utils/text';
+import {
+  findPlaceAppearances,
+  useAppearanceWritings,
