{
  "schema": 1,
  "id": "writer",
  "name": "Writer's Hoard",
  "purpose": "Draft, edit and query manuscripts, plus interactive-fiction world state, continuity, sessions, dice, threads and clocks in Writer.",
  "capabilities": [
    "documents",
    "notes",
    "outline",
    "search",
    "manuscripts",
    "worldbuilding",
    "ai-bridge",
    "interactive-fiction",
    "continuity",
    "dice",
    "story-worlds",
    "document-library",
    "web-library",
    "paperwork",
    "mail",
    "pdf-tools",
    "editable-publications",
    "hosted-reading-links",
    "markdown-document-check"
  ],
  "placeholders": [
    "WRITER_DIR",
    "APP_URL",
    "TOKEN_FILE",
    "DATA_DIR",
    "WRITER_EXE",
    "WRITER_ADAPTER",
    "WRITER_INSTALL_DIR"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:8766",
    "TOKEN_FILE": "%APPDATA%/writers-hoard/aibridge/token",
    "DATA_DIR": "%APPDATA%/writers-hoard/backups",
    "WRITER_EXE": "%LOCALAPPDATA%/Programs/Writers Hoard/Writers Hoard.exe",
    "WRITER_ADAPTER": "{WRITER_DIR}/dist-electron/aibridge/mcpStdio.cjs",
    "WRITER_INSTALL_DIR": "%LOCALAPPDATA%/Programs/Writers Hoard"
  },
  "app": {
    "url_default": "http://127.0.0.1:8766",
    "ui_url": null,
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "writers-hoard-ai-bridge"
      }
    },
    "identify": {
      "service": [
        "writers-hoard-ai-bridge"
      ],
      "title": [
        "writer's hoard",
        "writers hoard"
      ]
    },
    "launch_hint": {
      "kind": "process",
      "executable": "{WRITER_EXE}",
      "argv": [],
      "cwd": "{WRITER_INSTALL_DIR}",
      "readiness": {
        "url": "{APP_URL}/api/health",
        "timeout_s": 40
      }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{WRITER_EXE}",
    "args": [
      "{WRITER_ADAPTER}"
    ],
    "env": {
      "WH_BRIDGE_URL": "{APP_URL}",
      "WH_BRIDGE_TOKEN_FILE": "{TOKEN_FILE}",
      "WH_SKILLS_DIR": "{DATA_DIR}/skills",
      "ELECTRON_RUN_AS_NODE": "1"
    },
    "optional_env": [
      "WH_BRIDGE_GROUPS"
    ]
  },
  "x-family": {
    "production": {
      "handoffs": [
        {"accepts": "production-brief", "produces": ["scene-brief", "editable-report"], "skill": "writing-plans", "check": {"en": "Reread the chapter, world date and character details, or reopen the exported report and compare citations with its sources.", "es": "Relee el capítulo, la fecha del mundo y los detalles del personaje, o abre el informe exportado y coteja las citas con sus fuentes."}},
        {"accepts": "research-dossier", "produces": ["editable-report"], "skill": "notes-from-templates", "check": {"en": "Reopen the report and check that cited sources, links and tables survived export.", "es": "Abre el informe y comprueba que la exportación conserva las citas, los enlaces y las tablas."}}
      ]
    },
    "module_controls": {
      "publishing": {"list": "wh_publishing_modules", "set": "wh_publishing_module_set", "name_field": "id"},
      "story": {"list": "wh_story_modules", "set": "wh_story_module_set", "name_field": "id", "automatic": false}
    },
    "stack": "node",
    "copilot": {
      "contract_version": "1.0",
      "panel": "faustus-chat",
      "context_tool": "wh_get_context",
      "projects_tool": "wh_list_projects",
      "instructions_tool": "wh_get_editorial_context",
      "transport": "electron-ipc",
      "object_types": [
        "writings",
        "codex",
        "notes",
        "outline",
        "maps",
        "worldgen"
      ],
      "native_undo": true
    },
    "note": "A desktop app: the port answers only while the AI bridge is switched on in Settings. The token lives under the user's profile, not in the repository folder. DATA_DIR is the app's own archive folder (the ZIP snapshots it rotates itself): a consistent copy of every project, small, never the live IndexedDB store or the media cache.",
    "absorbs": [
      "scheherazade",
      "borges",
      "gutenberg"
    ],
    "uses": [
      "links",
      "kafka"
    ],
    "fiction": {
      "modules": [
        "fiction",
        "narration",
        "voice",
        "illustrations"
      ],
      "default_enabled": [],
      "api_prefix": "/api/fiction",
      "runtime": "owned private stdio worker",
      "data": "in-place selectable directory; no automatic migration"
    }
  },
  "notes": "The AI bridge is off by default; turn it on in Writers Hoard \u2192 Settings \u2192 AI bridge. /api/health answers without a token; every other route needs the bridge token as a Bearer.",
  "provides": {
    "skills": {"slugs": ["manuscript-continuity-edit", "writing-plans", "notes-from-templates"], "limit": 3}
  },
  "skills": {"slugs": ["manuscript-continuity-edit", "writing-plans", "notes-from-templates"], "limit": 3}
}
