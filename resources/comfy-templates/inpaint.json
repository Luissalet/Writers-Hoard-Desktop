        "strength_clip": 1.0
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Positive"
      },
      "inputs": {
        "text": "",
        "clip": ["13", 1]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Negative"
      },
      "inputs": {
        "text": "",
        "clip": ["13", 1]
      }
    },
    "5": {
      "class_type": "KSampler",
      "_meta": {
        "title": "Sampler"
      },
      "inputs": {
        "model": ["13", 0],
        "seed": 0,
        "steps": 25,
        "cfg": 6.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["77", 0],
        "denoise": 1.0
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "_meta": {
        "title": "Decode"
      },
      "inputs": {
        "samples": ["5", 0],
        "vae": ["1", 2]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "_meta": {
        "title": "Output"
      },
      "inputs": {
        "images": ["79", 0],
        "filename_prefix": "WritersHoard/wh"
      }
    },
    "70": {
      "class_type": "LoadImage",
      "_meta": {
        "title": "Source"
      },
      "inputs": {
        "image": ""
      }
    },
    "71": {
      "class_type": "LoadImage",
      "_meta": {
        "title": "Mask Source"
      },
      "inputs": {
        "image": ""
      }
    },
    "72": {
      "class_type": "ImageCrop",
      "_meta": {
        "title": "Crop Source"
      },
      "inputs": {
        "image": ["70", 0],
        "width": 512,
        "height": 512,
        "x": 0,
        "y": 0
      }
    },
    "73": {
      "class_type": "ImageScale",
      "_meta": {
        "title": "Scale Source"
      },
      "inputs": {
        "image": ["72", 0],
        "upscale_method": "lanczos",
        "width": 1024,
        "height": 1024,
        "crop": "disabled"
      }
    },
    "74": {
      "class_type": "ImageCrop",
      "_meta": {
        "title": "Crop Mask"
      },
      "inputs": {
        "image": ["71", 0],
        "width": 512,
        "height": 512,
        "x": 0,
        "y": 0
      }
    },
    "75": {
      "class_type": "ImageScale",
      "_meta": {
        "title": "Scale Mask"
      },
      "inputs": {
        "image": ["74", 0],
        "upscale_method": "bilinear",
        "width": 1024,
        "height": 1024,
        "crop": "disabled"
      }
    },
    "76": {
      "class_type": "ImageToMask",
      "_meta": {
        "title": "Work Mask"
      },
      "inputs": {
        "image": ["75", 0],
        "channel": "red"
      }
    },
    "77": {
      "class_type": "VAEEncodeForInpaint",
      "_meta": {
        "title": "Encode"
      },
      "inputs": {
        "pixels": ["73", 0],
        "vae": ["1", 2],
        "mask": ["76", 0],
        "grow_mask_by": 6
      }
    },
    "78": {
      "class_type": "ImageScale",
      "_meta": {
        "title": "Scale Back"
      },
      "inputs": {
        "image": ["6", 0],
        "upscale_method": "lanczos",
        "width": 512,
        "height": 512,
        "crop": "disabled"
      }
    },
    "80": {
      "class_type": "ImageToMask",
      "_meta": {
        "title": "Paste Mask"
      },
      "inputs": {
        "image": ["74", 0],
        "channel": "red"
      }
    },
    "79": {
      "class_type": "ImageCompositeMasked",
      "_meta": {
        "title": "Composite"
      },
      "inputs": {
        "destination": ["70", 0],
        "source": ["78", 0],
        "x": 0,
        "y": 0,
        "resize_source": false,
        "mask": ["80", 0]
      }
    }
  }
