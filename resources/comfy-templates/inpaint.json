{
  "id": "inpaint",
  "label": "Inpaint (only masked)",
  "description": "Repaints the masked area at full model resolution and composites it back \u2014 the crop/scale/composite that keeps a small fix from being rendered at postage-stamp detail.",
  "requires": [
    "CheckpointLoaderSimple",
    "CLIPTextEncode",
    "KSampler",
    "VAEDecode",
    "SaveImage",
    "LoadImage",
    "ImageCrop",
    "ImageScale",
    "ImageToMask",
    "VAEEncodeForInpaint",
    "ImageCompositeMasked"
  ],
