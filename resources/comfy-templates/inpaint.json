      }
    },
    "10": {
      "class_type": "LoraLoader",
      "_meta": {
        "title": "LoRA 1"
      },
      "inputs": {
        "model": ["1", 0],
        "clip": ["1", 1],
        "lora_name": "",
        "strength_model": 1.0,
        "strength_clip": 1.0
      }
    },
    "11": {
      "class_type": "LoraLoader",
      "_meta": {
        "title": "LoRA 2"
      },
      "inputs": {
        "model": ["10", 0],
        "clip": ["10", 1],
        "lora_name": "",
        "strength_model": 1.0,
        "strength_clip": 1.0
      }
    },
    "12": {
      "class_type": "LoraLoader",
      "_meta": {
        "title": "LoRA 3"
      },
      "inputs": {
        "model": ["11", 0],
