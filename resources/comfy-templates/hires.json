        "title": "Output"
      },
      "inputs": {
        "images": ["6", 0],
        "filename_prefix": "WritersHoard/wh"
      }
    },
    "8": {
      "class_type": "LatentUpscale",
      "_meta": {
        "title": "Hires Upscale"
      },
      "inputs": {
        "samples": ["5", 0],
        "upscale_method": "bislerp",
        "width": 1536,
        "height": 1536,
        "crop": "disabled"
      }
    },
    "9": {
      "class_type": "KSampler",
      "_meta": {
        "title": "Hires Sampler"
      },
      "inputs": {
        "model": ["23", 0],
        "seed": 0,
